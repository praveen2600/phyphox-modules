    </max>
    <formula formula="max(0.001,([2]-[1])*0.04)">
      <input keep="true">b_plot_min</input>
      <input keep="true">b_plot_max</input>
      <output append="false">b_plot_pad</output>
    </formula>
    <formula formula="[1]-[2]">
