        <input axis="x">m_lower_x</input>
        <input axis="y" color="blue" lineWidth="0.75" style="lines">m_line_y</input>
        <input axis="x">m_upper_x</input>
        <input axis="y" color="blue" lineWidth="0.75" style="lines">m_line_y</input>
      </graph>
      <graph label="Raw acceleration without g - Z" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="signal_33">
        <input axis="x">t_window</input>
        <input axis="y" color="white" lineWidth="1" style="lines">a_window</input>
        <input axis="x">b_t</input>
        <input axis="y" color="green" lineWidth="1.5" style="lines">b_a</input>
        <input axis="x">m_t</input>
        <input axis="y" color="blue" lineWidth="1.5" style="lines">m_a</input>
        <input axis="x">b_lower_x</input>
        <input axis="y" color="green" lineWidth="0.75" style="lines">b_line_y</input>
        <input axis="x">b_upper_x</input>
        <input axis="y" color="green" lineWidth="0.75" style="lines">b_line_y</input>
        <input axis="x">m_lower_x</input>
        <input axis="y" color="blue" lineWidth="0.75" style="lines">m_line_y</input>
        <input axis="x">m_upper_x</input>
        <input axis="y" color="blue" lineWidth="0.75" style="lines">m_line_y</input>
      </graph>
      <value label="Correction range" format="ascii" size="0.8">
        <input>b_time_text</input>
      </value>
      <slider type="range" minValue="0" maxValue="100" stepSize="0.01" showValue="false" color="green">
        <output value="lowerValue">bias_low_pct</output>
        <output value="upperValue">bias_high_pct</output>
      </slider>
      <button label="Calculate/Remove correction" dynamicLabel="label_code">
        <input>next_action</input>
        <output>corr_action</output>
        <map max="0.5">Calculate/Remove correction</map>
        <map min="0.5" max="1.5">Calculate correction</map>
        <map min="1.5">Remove correction</map>
      </button>
      <value label="Accl. correction" precision="6" size="0.8" unit="m/s²" visibility="is_acc">
        <input>applied_correction</input>
      </value>
      <value label="Gyro correction" precision="6" size="0.8" unit="rad/s" visibility="is_gyro">
        <input>applied_correction</input>
      </value>
      <value label="Integrate range" format="ascii" size="0.8">
        <input>m_time_text</input>
      </value>
      <slider type="range" minValue="0" maxValue="100" stepSize="0.01" showValue="false" color="blue">
        <output value="lowerValue">motion_low_pct</output>
        <output value="upperValue">motion_high_pct</output>
      </slider>
      <graph label="Corrected acceleration - X" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="signal_11">
        <input axis="x">m_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">m_zero_y</input>
        <input axis="x">m_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">corrected_candidate</input>
      </graph>
      <graph label="Corrected acceleration - Y" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="signal_12">
        <input axis="x">m_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">m_zero_y</input>
        <input axis="x">m_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">corrected_candidate</input>
      </graph>
      <graph label="Corrected acceleration - Z" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="signal_13">
        <input axis="x">m_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">m_zero_y</input>
        <input axis="x">m_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">corrected_candidate</input>
      </graph>
      <graph label="Corrected angular velocity - X" labelX="Time" unitX="s" labelY="Angular velocity" unitY="rad/s" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="signal_21">
        <input axis="x">m_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">m_zero_y</input>
        <input axis="x">m_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">corrected_candidate</input>
      </graph>
      <graph label="Corrected angular velocity - Y" labelX="Time" unitX="s" labelY="Angular velocity" unitY="rad/s" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="signal_22">
        <input axis="x">m_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">m_zero_y</input>
        <input axis="x">m_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">corrected_candidate</input>
      </graph>
      <graph label="Corrected angular velocity - Z" labelX="Time" unitX="s" labelY="Angular velocity" unitY="rad/s" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="signal_23">
        <input axis="x">m_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">m_zero_y</input>
        <input axis="x">m_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">corrected_candidate</input>
      </graph>
      <graph label="Corrected acceleration - X" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="signal_31">
        <input axis="x">m_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">m_zero_y</input>
        <input axis="x">m_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">corrected_candidate</input>
      </graph>
      <graph label="Corrected acceleration - Y" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="signal_32">
        <input axis="x">m_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">m_zero_y</input>
        <input axis="x">m_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">corrected_candidate</input>
      </graph>
      <graph label="Corrected acceleration - Z" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="signal_33">
        <input axis="x">m_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">m_zero_y</input>
        <input axis="x">m_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">corrected_candidate</input>
      </graph>
      <info label="Corrected = raw − correction. Gray line = zero." size="0.75" />
      <edit label="Initial velocity" unit="m/s" default="0" signed="true" decimal="true" visibility="is_acc">
        <output>v0</output>
      </edit>
      <graph label="Velocity - X" labelX="Time" unitX="s" labelY="Velocity" unitY="m/s" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="v_axis_1">
        <input axis="x">result_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">v</input>
      </graph>
      <graph label="Angle - X" labelX="Time" unitX="s" labelY="Angle" unitY="rad" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="theta_axis_1">
        <input axis="x">result_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">v</input>
      </graph>
      <graph label="Displacement / distance - X" labelX="Time" unitX="s" labelY="Displacement / distance" unitY="m" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="x_axis_1">
        <input axis="x">acc_result_t</input>
        <input axis="y" color="orange" lineWidth="2" style="lines">displacement</input>
        <input axis="x">acc_result_t</input>
        <input axis="y" color="magenta" lineWidth="1" style="dots">distance</input>
      </graph>
      <info label="— Displacement" color="orange" size="0.75" visibility="x_axis_1" />
      <info label="••• Distance" color="magenta" size="0.75" visibility="x_axis_1" />
      <graph label="Velocity - Y" labelX="Time" unitX="s" labelY="Velocity" unitY="m/s" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="v_axis_2">
        <input axis="x">result_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">v</input>
      </graph>
      <graph label="Angle - Y" labelX="Time" unitX="s" labelY="Angle" unitY="rad" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="theta_axis_2">
        <input axis="x">result_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">v</input>
      </graph>
      <graph label="Displacement / distance - Y" labelX="Time" unitX="s" labelY="Displacement / distance" unitY="m" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="x_axis_2">
        <input axis="x">acc_result_t</input>
        <input axis="y" color="orange" lineWidth="2" style="lines">displacement</input>
        <input axis="x">acc_result_t</input>
        <input axis="y" color="magenta" lineWidth="1" style="dots">distance</input>
      </graph>
      <info label="— Displacement" color="orange" size="0.75" visibility="x_axis_2" />
      <info label="••• Distance" color="magenta" size="0.75" visibility="x_axis_2" />
      <graph label="Velocity - Z" labelX="Time" unitX="s" labelY="Velocity" unitY="m/s" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="v_axis_3">
        <input axis="x">result_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">v</input>
      </graph>
      <graph label="Angle - Z" labelX="Time" unitX="s" labelY="Angle" unitY="rad" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="theta_axis_3">
        <input axis="x">result_t</input>
        <input axis="y" color="blue" lineWidth="2" style="lines">v</input>
      </graph>
      <graph label="Displacement / distance - Z" labelX="Time" unitX="s" labelY="Displacement / distance" unitY="m" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="x_axis_3">
        <input axis="x">acc_result_t</input>
        <input axis="y" color="orange" lineWidth="2" style="lines">displacement</input>
        <input axis="x">acc_result_t</input>
        <input axis="y" color="magenta" lineWidth="1" style="dots">distance</input>
      </graph>
      <info label="— Displacement" color="orange" size="0.75" visibility="x_axis_3" />
      <info label="••• Distance" color="magenta" size="0.75" visibility="x_axis_3" />
      <info label="Initial velocity 0 requires rest at the selected start. Keep phone orientation fixed." size="0.75" visibility="is_acc" />
      <info label="Gyroscope integrates to angle for fixed-axis rotation." size="0.75" visibility="is_gyro" />
    </view>
    <view label="Raw">
      <graph label="Acceleration with g - X" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_1">
        <input axis="x">t_all</input>
        <input axis="y" color="orange" lineWidth="1" style="lines">x_all</input>
      </graph>
      <graph label="Acceleration without g - X" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_3">
        <input axis="x">t_all</input>
        <input axis="y" color="orange" lineWidth="1" style="lines">x_all</input>
      </graph>
      <graph label="Gyroscope - X" labelX="Time" unitX="s" labelY="Angular velocity" unitY="rad/s" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_2">
        <input axis="x">t_all</input>
        <input axis="y" color="orange" lineWidth="1" style="lines">x_all</input>
      </graph>
      <graph label="Acceleration with g - Y" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_1">
        <input axis="x">t_all</input>
        <input axis="y" color="green" lineWidth="1" style="lines">y_all</input>
      </graph>
      <graph label="Acceleration without g - Y" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_3">
        <input axis="x">t_all</input>
        <input axis="y" color="green" lineWidth="1" style="lines">y_all</input>
      </graph>
      <graph label="Gyroscope - Y" labelX="Time" unitX="s" labelY="Angular velocity" unitY="rad/s" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_2">
        <input axis="x">t_all</input>
        <input axis="y" color="green" lineWidth="1" style="lines">y_all</input>
      </graph>
      <graph label="Acceleration with g - Z" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_1">
        <input axis="x">t_all</input>
        <input axis="y" color="blue" lineWidth="1" style="lines">z_all</input>
      </graph>
      <graph label="Acceleration without g - Z" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_3">
        <input axis="x">t_all</input>
        <input axis="y" color="blue" lineWidth="1" style="lines">z_all</input>
      </graph>
      <graph label="Gyroscope - Z" labelX="Time" unitX="s" labelY="Angular velocity" unitY="rad/s" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_2">
        <input axis="x">t_all</input>
        <input axis="y" color="blue" lineWidth="1" style="lines">z_all</input>
      </graph>
      <graph label="Acceleration with g - Absolute" labelX="Time" unitX="s" labelY="Magnitude" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_1">
        <input axis="x">t_all</input>
        <input axis="y" color="magenta" lineWidth="1" style="lines">magnitude_all</input>
      </graph>
      <graph label="Acceleration without g - Absolute" labelX="Time" unitX="s" labelY="Magnitude" unitY="m/s²" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_3">
        <input axis="x">t_all</input>
        <input axis="y" color="magenta" lineWidth="1" style="lines">magnitude_all</input>
      </graph>
      <graph label="Gyroscope - Absolute" labelX="Time" unitX="s" labelY="Magnitude" unitY="rad/s" aspectRatio="2.6" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="sensor_2">
        <input axis="x">t_all</input>
        <input axis="y" color="magenta" lineWidth="1" style="lines">magnitude_all</input>
      </graph>
      <value label="Recorded rate" precision="1" size="0.8" unit="Hz" visibility="has_rate">
        <input>recorded_rate</input>
      </value>
      <info label="Full original recording at the fastest available rate. No added smoothing." size="0.75" />
    </view>
  </views>
  <export>
    <set name="Raw acceleration with g">
      <data name="Time (s)">t</data>
      <data name="X (m/s^2)">ax</data>
      <data name="Y (m/s^2)">ay</data>
      <data name="Z (m/s^2)">az</data>
    </set>
    <set name="Raw acceleration without g">
      <data name="Time (s)">lt</data>
      <data name="X (m/s^2)">lx</data>
      <data name="Y (m/s^2)">ly</data>
      <data name="Z (m/s^2)">lz</data>
    </set>
    <set name="Raw gyroscope">
      <data name="Time (s)">gt</data>
      <data name="X (rad/s)">gx</data>
      <data name="Y (rad/s)">gy</data>
      <data name="Z (rad/s)">gz</data>
    </set>
    <set name="Pending correction samples">
      <data name="Time (s)">b_t</data>
      <data name="Reading (selected sensor units)">b_a</data>
    </set>
    <set name="Motion samples">
      <data name="Time (s)">m_t</data>
      <data name="Time from first included sample (s)">elapsed_t</data>
      <data name="Raw (selected sensor units)">m_a</data>
      <data name="Corrected (selected sensor units)">corrected</data>
    </set>
    <set name="Linear motion">
      <data name="Time (s)">acc_result_t</data>
      <data name="Velocity (m/s)">velocity_export</data>
      <data name="Displacement (m)">displacement</data>
      <data name="Distance along axis (m)">distance</data>
    </set>
    <set name="Angular motion">
      <data name="Time (s)">gyro_result_t</data>
      <data name="Angle (rad)">angle_export</data>
    </set>
    <set name="Settings">
      <data name="Sensor (1=with g 2=gyro 3=without g)">sensor_choice</data>
      <data name="Axis (1=X 2=Y 3=Z)">axis</data>
      <data name="Applied correction sensor-axis code">cal_choice</data>
      <data name="Correction interval start (s)">cal_start</data>
      <data name="Correction interval end (s)">cal_end</data>
      <data name="Correction samples">cal_n</data>
      <data name="Applied correction (sensor units)">applied_correction</data>
      <data name="Correction valid (1=yes)">bias_valid</data>
      <data name="Correction mode (0=none 1=calculated 2=removed)">correction_mode</data>
      <data name="Recorded rate (Hz)">recorded_rate</data>
      <data name="Analysis window duration (s)">window_duration</data>
      <data name="Motion first sample (s)">m_start</data>
      <data name="Motion last sample (s)">m_end</data>
      <data name="Motion samples">m_n</data>
      <data name="Initial velocity (m/s; ignored for gyro)">v0</data>
      <data name="Results valid (1=yes)">valid</data>
    </set>
  </export>
</phyphox>