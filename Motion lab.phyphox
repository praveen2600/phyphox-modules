  <input>
    <sensor type="accelerometer" rate="0" rateStrategy="request" average="false" stride="1">
      <output component="x">ax</output>
      <output component="y">ay</output>
      <output component="z">az</output>
      <output component="t">t</output>
    </sensor>
    <sensor type="linear_acceleration" rate="0" rateStrategy="request" average="false" stride="1" ignoreUnavailable="true">
      <output component="x">lx</output>
      <output component="y">ly</output>
      <output component="z">lz</output>
      <output component="t">lt</output>
    </sensor>
    <sensor type="gyroscope" rate="0" rateStrategy="request" average="false" stride="1" ignoreUnavailable="true">
      <output component="x">gx</output>
      <output component="y">gy</output>
      <output component="z">gz</output>
      <output component="t">gt</output>
    </sensor>
  </input>
  <analysis sleep="0.05">
    <formula formula="10*[1]+[2]">
      <input keep="true">sensor_choice</input>
      <input keep="true">axis</input>
      <output append="false">signal_choice</output>
    </formula>
    <if equal="true">
      <input keep="true" as="a">sensor_choice</input>
      <input type="value" as="b">2</input>
      <input type="value" as="true">1</input>
      <input type="value" as="false">0</input>
      <output append="false" as="result">is_gyro</output>
    </if>
    <formula formula="1-[1]">
      <input keep="true">is_gyro</input>
      <output append="false">is_acc</output>
    </formula>
    <if equal="true">
      <input keep="true" as="a">sensor_choice</input>
      <input type="value" as="b">3</input>
      <input keep="true" as="true">lt</input>
      <input keep="true" as="false">t</input>
      <output append="false" as="result">t_all_acc</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">sensor_choice</input>
      <input type="value" as="b">2</input>
      <input keep="true" as="true">gt</input>
      <input keep="true" as="false">t_all_acc</input>
      <output append="false" as="result">t_all</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">sensor_choice</input>
      <input type="value" as="b">3</input>
      <input keep="true" as="true">lx</input>
      <input keep="true" as="false">ax</input>
      <output append="false" as="result">x_all_acc</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">sensor_choice</input>
      <input type="value" as="b">2</input>
      <input keep="true" as="true">gx</input>
      <input keep="true" as="false">x_all_acc</input>
      <output append="false" as="result">x_all</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">sensor_choice</input>
      <input type="value" as="b">3</input>
      <input keep="true" as="true">ly</input>
      <input keep="true" as="false">ay</input>
      <output append="false" as="result">y_all_acc</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">sensor_choice</input>
      <input type="value" as="b">2</input>
      <input keep="true" as="true">gy</input>
      <input keep="true" as="false">y_all_acc</input>
      <output append="false" as="result">y_all</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">sensor_choice</input>
      <input type="value" as="b">3</input>
      <input keep="true" as="true">lz</input>
      <input keep="true" as="false">az</input>
      <output append="false" as="result">z_all_acc</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">sensor_choice</input>
      <input type="value" as="b">2</input>
      <input keep="true" as="true">gz</input>
      <input keep="true" as="false">z_all_acc</input>
      <output append="false" as="result">z_all</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">axis</input>
      <input type="value" as="b">2</input>
      <input keep="true" as="true">y_all</input>
      <input keep="true" as="false">z_all</input>
      <output append="false" as="result">yz</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">axis</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">x_all</input>
      <input keep="true" as="false">yz</input>
      <output append="false" as="result">a_all</output>
    </if>
    <count>
      <input keep="true">a_all</input>
      <output append="false">n_all</output>
    </count>
    <min>
      <input keep="true" as="y">t_all</input>
      <output append="false" as="min">t_first</output>
    </min>
    <max>
      <input keep="true" as="y">t_all</input>
      <output append="false" as="max">t_last</output>
    </max>
    <formula formula="[2]-[1]">
      <input keep="true">t_first</input>
      <input keep="true">t_last</input>
      <output append="false">run_duration</output>
    </formula>
    <formula formula="min(100,max(0,[1]))">
      <input keep="true">t_last</input>
      <output append="false">window_end</output>
    </formula>
    <rangefilter>
      <input keep="true" as="in">t_all</input>
      <input type="value" as="min">0</input>
      <input keep="true" as="max">window_end</input>
      <input keep="true" as="in">a_all</input>
      <output append="false" as="out">t_window</output>
      <output append="false" as="out">a_window</output>
    </rangefilter>
    <min>
      <input keep="true" as="y">t_window</input>
      <output append="false" as="min">window_start</output>
    </min>
    <max>
      <input keep="true" as="y">t_window</input>
      <output append="false" as="max">window_stop</output>
    </max>
    <formula formula="max(0,[2]-[1])">
      <input keep="true">window_start</input>
      <input keep="true">window_stop</input>
      <output append="false">window_duration</output>
    </formula>
    <formula formula="sqrt([1_]^2+[2_]^2+[3_]^2)">
      <input keep="true">x_all</input>
      <input keep="true">y_all</input>
      <input keep="true">z_all</input>
      <output append="false">magnitude_all</output>
    </formula>
    <formula formula="max(0,min(100,min([1],[2])))">
      <input keep="true">bias_low_pct</input>
      <input keep="true">bias_high_pct</input>
      <output append="false">b_low</output>
    </formula>
    <formula formula="max(0,min(100,max([1],[2])))">
      <input keep="true">bias_low_pct</input>
      <input keep="true">bias_high_pct</input>
      <output append="false">b_high</output>
    </formula>
    <formula formula="[1]*(1-[3]/100)+[2]*([3]/100)">
      <input keep="true">window_start</input>
      <input keep="true">window_stop</input>
      <input keep="true">b_low</input>
      <output append="false">b_lower</output>
    </formula>
    <formula formula="[1]*(1-[3]/100)+[2]*([3]/100)">
      <input keep="true">window_start</input>
      <input keep="true">window_stop</input>
      <input keep="true">b_high</input>
      <output append="false">b_upper</output>
    </formula>
    <rangefilter>
      <input keep="true" as="in">t_window</input>
      <input keep="true" as="min">b_lower</input>
      <input keep="true" as="max">b_upper</input>
      <input keep="true" as="in">a_window</input>
      <output append="false" as="out">b_t</output>
      <output append="false" as="out">b_a</output>
    </rangefilter>
    <count>
      <input keep="true">b_a</input>
      <output append="false">b_n</output>
    </count>
    <min>
      <input keep="true" as="y">b_t</input>
      <output append="false" as="min">b_start</output>
    </min>
    <max>
      <input keep="true" as="y">b_t</input>
      <output append="false" as="max">b_end</output>
    </max>
    <if greater="true">
      <input keep="true" as="a">b_n</input>
      <input type="value" as="b">1</input>
      <input type="value" as="true">1</input>
      <input type="value" as="false">0</input>
      <output append="false" as="result">b_enough</output>
    </if>
    <formula formula="max(0,min(100,min([1],[2])))">
      <input keep="true">motion_low_pct</input>
      <input keep="true">motion_high_pct</input>
      <output append="false">m_low</output>
    </formula>
    <formula formula="max(0,min(100,max([1],[2])))">
      <input keep="true">motion_low_pct</input>
      <input keep="true">motion_high_pct</input>
      <output append="false">m_high</output>
    </formula>
    <formula formula="[1]*(1-[3]/100)+[2]*([3]/100)">
      <input keep="true">window_start</input>
      <input keep="true">window_stop</input>
      <input keep="true">m_low</input>
      <output append="false">m_lower</output>
    </formula>
    <formula formula="[1]*(1-[3]/100)+[2]*([3]/100)">
      <input keep="true">window_start</input>
      <input keep="true">window_stop</input>
      <input keep="true">m_high</input>
      <output append="false">m_upper</output>
    </formula>
    <rangefilter>
      <input keep="true" as="in">t_window</input>
      <input keep="true" as="min">m_lower</input>
      <input keep="true" as="max">m_upper</input>
      <input keep="true" as="in">a_window</input>
      <output append="false" as="out">m_t</output>
      <output append="false" as="out">m_a</output>
    </rangefilter>
    <count>
      <input keep="true">m_a</input>
      <output append="false">m_n</output>
    </count>
    <min>
      <input keep="true" as="y">m_t</input>
      <output append="false" as="min">m_start</output>
    </min>
    <max>
      <input keep="true" as="y">m_t</input>
      <output append="false" as="max">m_end</output>
    </max>
    <if greater="true">
      <input keep="true" as="a">m_n</input>
      <input type="value" as="b">1</input>
      <input type="value" as="true">1</input>
      <input type="value" as="false">0</input>
      <output append="false" as="result">m_enough</output>
    </if>
    <formula formula="floor(max(0,min(100,[1]))*1000+0.5)">
      <input keep="true">b_start</input>
      <output append="false">b_start_text_ms</output>
    </formula>
    <formula formula="(48+floor([1]/[2_])-10*floor([1]/(10*[2_])))*min(1,max(0,floor([1]/[2_])+min(1,floor(1000/[2_]))))">
      <input keep="true">b_start_text_ms</input>
      <input keep="true">time_text_places</input>
