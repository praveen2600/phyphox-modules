  <views>
    <view label="Challenge">
      <info label="Where is the speed of the phone highest?" size="1.4" bold="true" align="center" />
      <info label="Hold the phone still. Press Play (▶)." size="1.1" align="center" visibility="PH0" />
      <info label="Get ready. Keep the phone still." color="FF9F1C" size="1.3" bold="true" align="center" visibility="PH1" />
      <value label="Starts in" precision="0" size="2.5" unit="s" color="FF9F1C" visibility="PH1">
        <input>cd_go</input>
      </value>
      <info label="GO! Move the phone, then stop." color="4CC04C" size="1.3" bold="true" align="center" visibility="PH2" />
      <info label="Keep the phone still." color="FF9F1C" size="1.3" bold="true" align="center" visibility="PH3" />
      <value label="Ends in" precision="0" size="2.5" unit="s" color="4CC04C" visibility="PH23">
        <input>cd_end</input>
      </value>
      <graph label="Acceleration (live)" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.2" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="LG0">
        <input axis="x">live_t</input>
        <input axis="y" color="blue" lineWidth="1.5" style="lines">live_a</input>
      </graph>
      <graph label="Acceleration along X (live)" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.2" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="LG1">
        <input axis="x">live_t</input>
        <input axis="y" color="blue" lineWidth="1.5" style="lines">live_a</input>
      </graph>
      <graph label="Acceleration along Y (live)" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.2" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="LG2">
        <input axis="x">live_t</input>
        <input axis="y" color="blue" lineWidth="1.5" style="lines">live_a</input>
      </graph>
      <graph label="Acceleration along Z (live)" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2.2" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="true" followX="false" visibility="LG3">
        <input axis="x">live_t</input>
        <input axis="y" color="blue" lineWidth="1.5" style="lines">live_a</input>
      </graph>
      <info label="Done." color="4CC04C" size="1.1" bold="true" align="center" visibility="DONE" />
      <info label="No usable data. Clear the data with the trash bin and press Play again." color="FF9F1C" visibility="INV_D" />
      <info label="The phone was moving when GO appeared. Clear the data with the trash bin and try again. Keep the phone still until GO." color="FF9F1C" visibility="WRS" />
      <info label="The phone was still moving at the end. Clear the data with the trash bin and try again. Use a shorter movement." color="FF9F1C" visibility="WRE" />
      <info label="The motion is very small. Clear the data and make a faster movement." color="FF9F1C" visibility="WSM" />
      <info label="Move the red line to the moment when the speed is highest. Then press Check." size="1.1" visibility="ASKING" />
      <graph label="Your acceleration (moving part)" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="QG0">
        <input axis="x">q_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">q_zero</input>
        <input axis="x">q_t</input>
        <input axis="y" color="blue" lineWidth="2.5" style="lines">q_a</input>
        <input axis="x">mk_x</input>
        <input axis="y" color="FF4040" lineWidth="2.5" style="lines">mk_ya</input>
      </graph>
      <graph label="Your acceleration along X (moving part)" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="QG1">
        <input axis="x">q_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">q_zero</input>
        <input axis="x">q_t</input>
        <input axis="y" color="blue" lineWidth="2.5" style="lines">q_a</input>
        <input axis="x">mk_x</input>
        <input axis="y" color="FF4040" lineWidth="2.5" style="lines">mk_ya</input>
      </graph>
      <graph label="Your acceleration along Y (moving part)" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="QG2">
        <input axis="x">q_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">q_zero</input>
        <input axis="x">q_t</input>
        <input axis="y" color="blue" lineWidth="2.5" style="lines">q_a</input>
        <input axis="x">mk_x</input>
        <input axis="y" color="FF4040" lineWidth="2.5" style="lines">mk_ya</input>
      </graph>
      <graph label="Your acceleration along Z (moving part)" labelX="Time" unitX="s" labelY="Acceleration" unitY="m/s²" aspectRatio="2" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="QG3">
        <input axis="x">q_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">q_zero</input>
        <input axis="x">q_t</input>
        <input axis="y" color="blue" lineWidth="2.5" style="lines">q_a</input>
        <input axis="x">mk_x</input>
        <input axis="y" color="FF4040" lineWidth="2.5" style="lines">mk_ya</input>
      </graph>
      <slider minValue="0" maxValue="100" stepSize="0.05" default="5" showValue="false" color="FF4040" visibility="SHOWQ">
        <output>marker_pct</output>
      </slider>
      <button label="Check" visibility="SHOWQ">
        <input>one</input>
        <output>check_action</output>
      </button>
      <info label="Correct! The speed is highest here." color="4CC04C" size="1.3" bold="true" visibility="fb11" />
      <info label="Not yet. Here the phone is still speeding up. Its speed becomes higher a little later." color="FF9F1C" size="1.1" visibility="fb12" />
      <info label="Not yet. Here the phone is already slowing down. Its speed was higher a little earlier." color="FF9F1C" size="1.1" visibility="fb13" />
      <info label="Not yet. Here the phone is almost at rest." color="FF9F1C" size="1.1" visibility="fb14" />
      <info label="Not yet. The phone moves faster at another moment." color="FF9F1C" size="1.1" visibility="fb15" />
      <info label="No result yet. Record a motion first." color="FF9F1C" visibility="fb90" />
      <info label="Not checked. The phone must be still at the start and at the end. Clear the data and try again." color="FF9F1C" visibility="fb91" />
      <info label="Hint: While the acceleration is on one side of zero, the phone speeds up. When the acceleration changes sign, the phone starts to slow down. Look for that moment." color="7FB2FF" size="1.05" visibility="hint" />
      <info label="The speed is highest where the acceleration crosses zero. Before this moment the phone speeds up. After it, the phone slows down." color="4CC04C" size="1.05" visibility="SOLVED_SHOW" />
      <graph label="Velocity (calculated from the acceleration)" labelX="Time" unitX="s" labelY="Velocity" unitY="m/s" aspectRatio="2" partialUpdate="false" scaleMinX="auto" scaleMaxX="auto" scaleMinY="auto" scaleMaxY="auto" timeOnX="false" followX="false" visibility="SOLVED_SHOW">
        <input axis="x">q_t</input>
        <input axis="y" color="808080" lineWidth="0.75" style="lines">q_zero</input>
        <input axis="x">q_t</input>
        <input axis="y" color="4CC04C" lineWidth="2.5" style="lines">q_v</input>
        <input axis="x">mk_x</input>
        <input axis="y" color="FF4040" lineWidth="2.5" style="lines">mk_yv</input>
      </graph>
      <info label="Try again: clear the data with the trash bin and press Play." size="0.8" visibility="DONE" />
    </view>
  </views>
  <export>
    <set name="Used part">
      <data name="Time (s)">result_t</data>
      <data name="Corrected acceleration (m/s^2)">corrected</data>
      <data name="Velocity (m/s)">v</data>
    </set>
    <set name="Raw acceleration without g">
      <data name="Time (s)">lt</data>
      <data name="X (m/s^2)">lx</data>
      <data name="Y (m/s^2)">ly</data>
      <data name="Z (m/s^2)">lz</data>
    </set>
    <set name="Raw acceleration with g">
      <data name="Time (s)">t</data>
      <data name="X (m/s^2)">ax</data>
      <data name="Y (m/s^2)">ay</data>
      <data name="Z (m/s^2)">az</data>
    </set>
    <set name="Result">
      <data name="Axis used (1=X 2=Y 3=Z)">axis_used</data>
      <data name="Correction (m/s^2)">corr</data>
      <data name="Highest speed (m/s)">vmax</data>
      <data name="Red line time (s)">t_m</data>
      <data name="Last feedback code">fb_code</data>
      <data name="Solved (1=yes)">solved</data>
      <data name="Wrong tries">wrong</data>
    </set>
  </export>
</phyphox>
