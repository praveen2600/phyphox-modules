  <input>
    <sensor type="accelerometer" rate="0" rateStrategy="request" average="false" stride="1">
      <output component="x">ax</output>
      <output component="y">ay</output>
      <output component="z">az</output>
      <output component="t">t</output>
    </sensor>
    <sensor type="linear_acceleration" rate="0" rateStrategy="request" average="false" stride="1" ignoreUnavailable="true">
      <output component="x">lx</output>
      <output component="y">ly</output>
      <output component="z">lz</output>
      <output component="t">lt</output>
    </sensor>
  </input>
  <analysis sleep="0.05">
    <formula formula="[1]-0.5">
      <input keep="true">delay_s</input>
      <output append="false">sel_lo</output>
    </formula>
    <formula formula="[1]+[2]">
      <input keep="true">delay_s</input>
      <input keep="true">run_s</input>
      <output append="false">end_t</output>
    </formula>
    <formula formula="[1]+[2]-1">
      <input keep="true">delay_s</input>
      <input keep="true">run_s</input>
      <output append="false">hold_t</output>
    </formula>
    <count>
      <input keep="true">t</input>
      <output append="false">n_t</output>
    </count>
    <max>
      <input keep="true" as="y">t</input>
      <output append="false" as="max">t_now</output>
    </max>
    <if greater="true">
      <input keep="true" as="a">n_t</input>
      <input type="value" as="b">0</input>
      <input type="value" as="true">1</input>
      <input type="value" as="false">0</input>
      <output append="false" as="result">started</output>
    </if>
    <if less="true">
      <input keep="true" as="a">t_now</input>
      <input keep="true" as="b">delay_s</input>
      <input type="value" as="true">1</input>
      <input type="value" as="false">0</input>
      <output append="false" as="result">before_go</output>
    </if>
    <if less="true">
      <input keep="true" as="a">t_now</input>
      <input keep="true" as="b">hold_t</input>
      <input type="value" as="true">1</input>
      <input type="value" as="false">0</input>
      <output append="false" as="result">before_hold</output>
    </if>
    <if less="true">
      <input keep="true" as="a">t_now</input>
      <input keep="true" as="b">end_t</input>
      <input type="value" as="true">1</input>
      <input type="value" as="false">0</input>
      <output append="false" as="result">before_end</output>
    </if>
    <formula formula="1-[1]">
      <input keep="true">started</input>
      <output append="false">PH0</output>
    </formula>
    <formula formula="[1]*[2]">
      <input keep="true">started</input>
      <input keep="true">before_go</input>
      <output append="false">PH1</output>
    </formula>
    <formula formula="[1]*(1-[2])*[3]">
      <input keep="true">started</input>
      <input keep="true">before_go</input>
      <input keep="true">before_hold</input>
      <output append="false">PH2</output>
    </formula>
    <formula formula="[1]*(1-[2])*[3]">
      <input keep="true">started</input>
      <input keep="true">before_hold</input>
      <input keep="true">before_end</input>
      <output append="false">PH3</output>
    </formula>
    <formula formula="[1]*(1-[2])">
      <input keep="true">started</input>
      <input keep="true">before_end</input>
      <output append="false">DONE</output>
    </formula>
    <formula formula="[1]+[2]+[3]">
      <input keep="true">PH1</input>
      <input keep="true">PH2</input>
      <input keep="true">PH3</input>
      <output append="false">LIVE</output>
    </formula>
    <formula formula="[1]+[2]">
      <input keep="true">PH2</input>
      <input keep="true">PH3</input>
      <output append="false">PH23</output>
    </formula>
    <formula formula="max(0,ceil([1]-[2]))">
      <input keep="true">delay_s</input>
      <input keep="true">t_now</input>
      <output append="false">cd_go</output>
    </formula>
    <formula formula="max(0,ceil([1]-[2]))">
      <input keep="true">end_t</input>
      <input keep="true">t_now</input>
      <output append="false">cd_end</output>
    </formula>
    <rangefilter>
      <input keep="true" as="in">t</input>
      <input type="value" as="min">-1000</input>
      <input keep="true" as="max">end_t</input>
      <output append="false" as="out">t_upto</output>
    </rangefilter>
    <count>
      <input keep="true">t_upto</input>
      <output append="false">sig_nt</output>
    </count>
    <if equal="true">
      <input keep="true" as="a">sig_nt</input>
      <input keep="true" as="b">prev_nt</input>
      <input type="value" as="true">1</input>
      <input type="value" as="false">0</input>
      <output append="false" as="result">same_nt</output>
    </if>
    <rangefilter>
      <input keep="true" as="in">lt</input>
      <input type="value" as="min">-1000</input>
      <input keep="true" as="max">end_t</input>
      <output append="false" as="out">lt_upto</output>
    </rangefilter>
    <count>
      <input keep="true">lt_upto</input>
      <output append="false">sig_nlt</output>
    </count>
    <if equal="true">
      <input keep="true" as="a">sig_nlt</input>
      <input keep="true" as="b">prev_nlt</input>
      <input type="value" as="true">1</input>
      <input type="value" as="false">0</input>
      <output append="false" as="result">same_nlt</output>
    </if>
    <formula formula="1-[1]*[2]">
      <input keep="true">same_nt</input>
      <input keep="true">same_nlt</input>
      <output append="false">data_changed</output>
    </formula>
    <if equal="true">
      <input keep="true" as="a">data_changed</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">t</input>
      <input type="empty" as="false" />
      <output append="false" as="result">g_t</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">data_changed</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">ax</input>
      <input type="empty" as="false" />
      <output append="false" as="result">g_ax</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">data_changed</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">ay</input>
      <input type="empty" as="false" />
      <output append="false" as="result">g_ay</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">data_changed</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">az</input>
      <input type="empty" as="false" />
      <output append="false" as="result">g_az</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">data_changed</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">lt</input>
      <input type="empty" as="false" />
      <output append="false" as="result">g_lt</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">data_changed</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">lx</input>
      <input type="empty" as="false" />
      <output append="false" as="result">g_lx</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">data_changed</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">ly</input>
      <input type="empty" as="false" />
      <output append="false" as="result">g_ly</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">data_changed</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">lz</input>
      <input type="empty" as="false" />
      <output append="false" as="result">g_lz</output>
    </if>
    <count>
      <input keep="true">g_lt</input>
      <output append="false">n_lin_n</output>
    </count>
    <if greater="true">
      <input keep="true" as="a">n_lin_n</input>
      <input type="value" as="b">10</input>
      <input type="value" as="true">1</input>
      <input type="value" as="false">0</input>
      <output append="false" as="result">use_lin_n</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">use_lin_n</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">g_lt</input>
      <input keep="true" as="false">g_t</input>
      <output append="false" as="result">t_all_n</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">use_lin_n</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">g_lx</input>
      <input keep="true" as="false">g_ax</input>
      <output append="false" as="result">x_all_n</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">use_lin_n</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">g_ly</input>
      <input keep="true" as="false">g_ay</input>
      <output append="false" as="result">y_all_n</output>
    </if>
    <if equal="true">
      <input keep="true" as="a">use_lin_n</input>
      <input type="value" as="b">1</input>
      <input keep="true" as="true">g_lz</input>
